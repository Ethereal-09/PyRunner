<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==== PyRunner 深色主题语义 Token（真相源：主题色板.md §八） ====
         全部界面颜色统一从这里取（ThemeResource），禁止在 XAML/代码直写色值。 -->

    <!-- 一、品牌与主色 -->
    <Color x:Key="AccentColor">#35A875</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#67CEA0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3DB982" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2B8E63" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#35A875" Offset="0" />
        <GradientStop Color="#2F9568" Offset="1" />
    </LinearGradientBrush>
    <!-- Logo 专用渐变（app-logo.svg：45° 对角） -->
    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4CC38A" Offset="0" />
        <GradientStop Color="#1A8A5A" Offset="1" />
    </LinearGradientBrush>

    <!-- 二、背景层级 -->
    <SolidColorBrush x:Key="AppBackgroundDarkBrush" Color="#0F1215" />
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0F1215" />
    <SolidColorBrush x:Key="MicaGradientTopBrush" Color="#202326" />
    <SolidColorBrush x:Key="MicaGradientMidBrush" Color="#1C1F22" />
    <SolidColorBrush x:Key="MicaGradientBottomBrush" Color="#191C1F" />
    <LinearGradientBrush x:Key="AppMicaGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#202326" Offset="0" />
        <GradientStop Color="#1C1F22" Offset="0.6" />
        <GradientStop Color="#191C1F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AcrylicDialogTopBrush" Color="#E6282A2F" />
    <SolidColorBrush x:Key="AcrylicDialogBottomBrush" Color="#EB1E2024" />
    <!-- 主窗口卡片/控件表面：对应设计稿 rgba(255,255,255,.04/.055/.07) -->
    <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#FF24272B" />
    <SolidColorBrush x:Key="PanelSurfaceRaisedBrush" Color="#FF2B2E32" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#FF25282C" />
    <SolidColorBrush x:Key="MainSurfaceBrush" Color="#FF25282C" />
    <SolidColorBrush x:Key="GhostButtonBrush" Color="#FF2B2F33" />
    <SolidColorBrush x:Key="GhostButtonHoverBrush" Color="#FF30363A" />
    <SolidColorBrush x:Key="TerminalTabStripBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#FF2B2F33" />
    <SolidColorBrush x:Key="ControlSurfaceHoverBrush" Color="#FF30363A" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#FF245440" />
    <SolidColorBrush x:Key="SelectedSurfaceHoverBrush" Color="#FF2A654C" />
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#FF30363A" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FF2B2F33" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#FF343A3F" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#FF202428" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#FF41484F" />
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#FFF0F2F4" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DisabledButtonBrush" Color="#FF24282C" />
    <SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#FF7E8995" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FF67CEA0" />
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#FF67CEA0" />
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FF191C1F" />
    <SolidColorBrush x:Key="BadgeSurfaceBrush" Color="#FF343A40" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#FFD9DEE4" />
    <SolidColorBrush x:Key="StatusBarSurfaceBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#2EFF8F8F" />
    <SolidColorBrush x:Key="DangerHoverSurfaceBrush" Color="#42FF8F8F" />
    <SolidColorBrush x:Key="DangerPressedSurfaceBrush" Color="#5CFF8F8F" />
    <SolidColorBrush x:Key="StatusRunningSurfaceBrush" Color="#38E6C07B" />
    <SolidColorBrush x:Key="StatusSuccessSurfaceBrush" Color="#3335A875" />
    <SolidColorBrush x:Key="StatusErrorSurfaceBrush" Color="#33FF8F8F" />
    <SolidColorBrush x:Key="StatusStoppedSurfaceBrush" Color="#FF343A40" />

    <!-- 独立首次启动窗口（产品规范 V1.1）：固定深灰 + 品牌绿视觉。 -->
    <SolidColorBrush x:Key="OnboardingWindowBackgroundBrush" Color="#15181A" />
    <SolidColorBrush x:Key="OnboardingBrandBackgroundBrush" Color="#111715" />
    <SolidColorBrush x:Key="OnboardingContentBackgroundBrush" Color="#1B1F21" />
    <SolidColorBrush x:Key="OnboardingCardBrush" Color="#252A2D" />
    <SolidColorBrush x:Key="OnboardingBorderBrush" Color="#30363A" />
    <SolidColorBrush x:Key="OnboardingAccentSurfaceBrush" Color="#3323684E" />
    <SolidColorBrush x:Key="OnboardingPrimaryTextBrush" Color="#F1F3F2" />
    <SolidColorBrush x:Key="OnboardingSecondaryTextBrush" Color="#9AA3A0" />
    <SolidColorBrush x:Key="OnboardingAccentTextBrush" Color="#07110D" />

    <!-- 三、文字层级 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF0F2F4" />
    <SolidColorBrush x:Key="TextTitleBrush" Color="#FFF0F2F4" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#FFD9DEE4" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFAAB2BC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8F9AA6" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF697580" />

    <!-- 四、边框与分隔 -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FF343A40" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#FF495159" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF41484F" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FF3DB982" />

    <!-- WinUI TreeView 默认模板消费的资源键：将系统蓝色选择态统一为品牌绿。 -->
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#FF30363A" />
    <LinearGradientBrush x:Key="TreeViewItemBackgroundSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#245440" Offset="0" />
        <GradientStop Color="#214B3A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A654C" Offset="0" />
        <GradientStop Color="#245440" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="#FFF0F2F4" />
    <SolidColorBrush x:Key="TreeViewItemForegroundDisabled" Color="#FF697580" />
    <!-- 原型选择态只有整行绿渐变与描边，不使用 WinUI 默认的左侧竖条。 -->
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundDisabled" Color="Transparent" />

    <!-- 五、状态色（running/success/failed/killed 与警告/危险） -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#FFD479" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#67CEA0" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#E6C07B" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF8F8F" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#FFAAB2BC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E81123" />

    <!-- 六、终端专属 -->
    <SolidColorBrush x:Key="TerminalPromptBrush" Color="#67CEA0" />
    <SolidColorBrush x:Key="TerminalCommandBrush" Color="#86B7E8" />
    <SolidColorBrush x:Key="TerminalWarningBrush" Color="#E6C07B" />
    <SolidColorBrush x:Key="TerminalErrorBrush" Color="#FF8F8F" />
    <SolidColorBrush x:Key="TerminalTimestampBrush" Color="#5C646D" />
    <SolidColorBrush x:Key="TerminalCursorBrush" Color="#7FE0AE" />

    <!-- 图标专用色（icons\使用指南.md §六） -->
    <SolidColorBrush x:Key="IconFolderBrush" Color="#E2B93D" />
    <SolidColorBrush x:Key="IconFolderLightBrush" Color="#F0D060" />
    <SolidColorBrush x:Key="IconMutedBrush" Color="#8A949E" />
    <SolidColorBrush x:Key="IconNeutralBrush" Color="#A0A8B1" />
    <SolidColorBrush x:Key="IconTextBrush" Color="#D6DAE0" />
    <SolidColorBrush x:Key="ScriptFileBackgroundBrush" Color="#22303A" />
    <SolidColorBrush x:Key="ScriptFileBorderBrush" Color="#3A5060" />

    <!-- ==== 字体层级（色板 §九） ==== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="TerminalFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <x:Double x:Key="FontSizeH1">24</x:Double>
    <x:Double x:Key="FontSizeH2">17</x:Double>
    <x:Double x:Key="FontSizeH3">15</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeCaption">11.5</x:Double>
    <x:Double x:Key="FontSizeOverline">10.5</x:Double>

    <!-- ==== 间距系统（色板 §十：4px 基础单位） ==== -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">12</x:Double>
    <x:Double x:Key="SpacingLG">16</x:Double>
    <x:Double x:Key="SpacingXL">20</x:Double>
    <x:Double x:Key="Spacing2XL">24</x:Double>
    <x:Double x:Key="Spacing3XL">32</x:Double>

    <!-- ==== 圆角 Token（WinUI 3 无 CornerRadius 字符串转换器，以双精度数登记） ==== -->
    <x:Double x:Key="CornerRadiusSmall">4</x:Double>
    <x:Double x:Key="CornerRadiusMedium">6</x:Double>
    <x:Double x:Key="CornerRadiusLarge">8</x:Double>
    <x:Double x:Key="CornerRadiusDialog">12</x:Double>
    <x:Double x:Key="CornerRadiusLogo">24</x:Double>

    <!-- 阴影分级（色板 §十一）：WinUI 3 用 ThemeShadow，Level 0 无阴影、
         Level 1~3 由元素 Translation Z 轴值体现，此处登记 Z 值 Token。 -->
    <x:Double x:Key="ShadowLevel1Z">8</x:Double>
    <x:Double x:Key="ShadowLevel2Z">24</x:Double>
    <x:Double x:Key="ShadowLevel3Z">80</x:Double>
</ResourceDictionary>
