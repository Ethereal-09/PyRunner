<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PyRunner 浅色主题：键集合必须与 DarkTheme.xaml 完全一致。 -->
    <Color x:Key="AccentColor">#2F9E70</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#27865E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#27865E" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#217451" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36A873" Offset="0" />
        <GradientStop Color="#278D61" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#42B77D" Offset="0" />
        <GradientStop Color="#167249" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AppBackgroundDarkBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#F6F8FA" />
    <SolidColorBrush x:Key="MicaGradientTopBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="MicaGradientMidBrush" Color="#F2F5F7" />
    <SolidColorBrush x:Key="MicaGradientBottomBrush" Color="#E9EEF2" />
    <LinearGradientBrush x:Key="AppMicaGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8FAFB" Offset="0" />
        <GradientStop Color="#F2F5F7" Offset="0.6" />
        <GradientStop Color="#E9EEF2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AcrylicDialogTopBrush" Color="#FAFFFFFF" />
    <SolidColorBrush x:Key="AcrylicDialogBottomBrush" Color="#F7F4F6F8" />
    <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PanelSurfaceRaisedBrush" Color="#FFF6F8FA" />
    <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#EFFFFFFF" />
    <SolidColorBrush x:Key="MainSurfaceBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="GhostButtonBrush" Color="#FFF6F8FA" />
    <SolidColorBrush x:Key="GhostButtonHoverBrush" Color="#FFEDF3F0" />
    <SolidColorBrush x:Key="TerminalTabStripBrush" Color="#0A17212A" />
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#FFF6F8FA" />
    <SolidColorBrush x:Key="ControlSurfaceHoverBrush" Color="#FFEDF3F0" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#FFDCEFE7" />
    <SolidColorBrush x:Key="SelectedSurfaceHoverBrush" Color="#FFCDE7DB" />
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#FFDCEFE7" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#FFEDF3F0" />
    <SolidColorBrush x:Key="SecondaryButtonPressedBrush" Color="#FFDCEFE7" />
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#FFD8DEE5" />
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#FF20262E" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DisabledButtonBrush" Color="#FFF0F2F4" />
    <SolidColorBrush x:Key="DisabledButtonForegroundBrush" Color="#FF8B959F" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FF2F9E70" />
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#FF2F9E70" />
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BadgeSurfaceBrush" Color="#FFE9EEF2" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#FF5F6B78" />
    <SolidColorBrush x:Key="StatusBarSurfaceBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#20C42B3A" />
    <SolidColorBrush x:Key="DangerHoverSurfaceBrush" Color="#2EC42B3A" />
    <SolidColorBrush x:Key="DangerPressedSurfaceBrush" Color="#40C42B3A" />
    <SolidColorBrush x:Key="StatusRunningSurfaceBrush" Color="#2ED89C24" />
    <SolidColorBrush x:Key="StatusSuccessSurfaceBrush" Color="#292F9E70" />
    <SolidColorBrush x:Key="StatusErrorSurfaceBrush" Color="#29C42B3A" />
    <SolidColorBrush x:Key="StatusStoppedSurfaceBrush" Color="#FFE9EEF2" />

    <!-- 首次启动窗口始终使用产品规范中的深色品牌配色。 -->
    <SolidColorBrush x:Key="OnboardingWindowBackgroundBrush" Color="#15181A" />
    <SolidColorBrush x:Key="OnboardingBrandBackgroundBrush" Color="#111715" />
    <SolidColorBrush x:Key="OnboardingContentBackgroundBrush" Color="#1B1F21" />
    <SolidColorBrush x:Key="OnboardingCardBrush" Color="#252A2D" />
    <SolidColorBrush x:Key="OnboardingBorderBrush" Color="#30363A" />
    <SolidColorBrush x:Key="OnboardingAccentSurfaceBrush" Color="#3323684E" />
    <SolidColorBrush x:Key="OnboardingPrimaryTextBrush" Color="#F1F3F2" />
    <SolidColorBrush x:Key="OnboardingSecondaryTextBrush" Color="#9AA3A0" />
    <SolidColorBrush x:Key="OnboardingAccentTextBrush" Color="#07110D" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF20262E" />
    <SolidColorBrush x:Key="TextTitleBrush" Color="#FF20262E" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#FF3F4A55" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5F6B78" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6C7884" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF8B959F" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFD8DEE5" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#FFB8C2CC" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFC7D0D9" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#FF2F9E70" />

    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#FFEDF3F0" />
    <LinearGradientBrush x:Key="TreeViewItemBackgroundSelected" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DCEFE7" Offset="0" />
        <GradientStop Color="#D4EADF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CDE7DB" Offset="0" />
        <GradientStop Color="#C5E1D4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FF20352D" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FF20352D" />
    <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="#FF20262E" />
    <SolidColorBrush x:Key="TreeViewItemForegroundDisabled" Color="#FF8B959F" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPressed" Color="Transparent" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundDisabled" Color="Transparent" />

    <SolidColorBrush x:Key="StatusRunningBrush" Color="#FF8A5B00" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#FF27865E" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FF8A5B00" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FFB42332" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#FF5F6B78" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B3A" />

    <SolidColorBrush x:Key="TerminalPromptBrush" Color="#FF2F9E70" />
    <SolidColorBrush x:Key="TerminalCommandBrush" Color="#FF245E91" />
    <SolidColorBrush x:Key="TerminalWarningBrush" Color="#FF8A5B00" />
    <SolidColorBrush x:Key="TerminalErrorBrush" Color="#FFB42332" />
    <SolidColorBrush x:Key="TerminalTimestampBrush" Color="#FF77838D" />
    <SolidColorBrush x:Key="TerminalCursorBrush" Color="#FF167249" />

    <SolidColorBrush x:Key="IconFolderBrush" Color="#FFB08A1C" />
    <SolidColorBrush x:Key="IconFolderLightBrush" Color="#FFD4AE37" />
    <SolidColorBrush x:Key="IconMutedBrush" Color="#FF6C7884" />
    <SolidColorBrush x:Key="IconNeutralBrush" Color="#FF596773" />
    <SolidColorBrush x:Key="IconTextBrush" Color="#FF394651" />
    <SolidColorBrush x:Key="ScriptFileBackgroundBrush" Color="#FFE3EDF2" />
    <SolidColorBrush x:Key="ScriptFileBorderBrush" Color="#FF9FB2BE" />

    <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="TerminalFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <x:Double x:Key="FontSizeH1">24</x:Double>
    <x:Double x:Key="FontSizeH2">17</x:Double>
    <x:Double x:Key="FontSizeH3">15</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeCaption">11.5</x:Double>
    <x:Double x:Key="FontSizeOverline">10.5</x:Double>
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">12</x:Double>
    <x:Double x:Key="SpacingLG">16</x:Double>
    <x:Double x:Key="SpacingXL">20</x:Double>
    <x:Double x:Key="Spacing2XL">24</x:Double>
    <x:Double x:Key="Spacing3XL">32</x:Double>
    <x:Double x:Key="CornerRadiusSmall">4</x:Double>
    <x:Double x:Key="CornerRadiusMedium">6</x:Double>
    <x:Double x:Key="CornerRadiusLarge">8</x:Double>
    <x:Double x:Key="CornerRadiusDialog">12</x:Double>
    <x:Double x:Key="CornerRadiusLogo">24</x:Double>
    <x:Double x:Key="ShadowLevel1Z">8</x:Double>
    <x:Double x:Key="ShadowLevel2Z">24</x:Double>
    <x:Double x:Key="ShadowLevel3Z">80</x:Double>
</ResourceDictionary>
