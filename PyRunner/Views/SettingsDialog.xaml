<ContentDialog
    x:Class="PyRunner.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PyRunner.Views"
    Title="{Binding Title}"
    PrimaryButtonText="{Binding OkText}"
    SecondaryButtonText="{Binding CancelText}"
    DefaultButton="Primary"
    Background="{ThemeResource PanelSurfaceRaisedBrush}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <local:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InvertBoolConverter x:Key="InvertBool" />
        <local:ValidToStatusBrushConverter x:Key="ValidToStatusBrush" />
        <local:MiddleEllipsisConverter x:Key="MiddleEllipsis" />
    </ContentDialog.Resources>

    <ScrollViewer x:Name="SettingsScroller" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel MinWidth="480" Spacing="12">

            <!-- ==== 分组一：脚本路径列表 ==== -->
            <TextBlock
                x:Name="ScriptPathsGroupTitle"
                Text="{Binding GroupScriptPaths}"
                FontSize="{ThemeResource FontSizeH3}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextTitleBrush}" />
            <ItemsControl ItemsSource="{Binding ScriptPaths}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding Path, Converter={StaticResource MiddleEllipsis}, ConverterParameter=58}"
                                ToolTipService.ToolTip="{Binding Path}"
                                FontSize="{ThemeResource FontSizeBody}"
                                Foreground="{ThemeResource TextBodyBrush}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <!-- Valid 绿 / Invalid 红（色板状态色 Token，经转换器） -->
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding StatusText}"
                                FontSize="{ThemeResource FontSizeCaption}"
                                Foreground="{Binding IsValid, Converter={StaticResource ValidToStatusBrush}}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="2"
                                AutomationProperties.AutomationId="SettingsRemovePathButton"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                MinWidth="26" MinHeight="24"
                                Padding="0"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="OnRemovePathClick" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
                x:Name="AddFolderButton"
                AutomationProperties.AutomationId="SettingsAddFolderButton"
                Content="{Binding AddFolderText}"
                Click="OnAddFolderClick" />

            <!-- ==== 分组二：解释器列表（异步版本检测）；分组标题 x:Name 供
                 「无解释器」空状态直达滚动定位（评审修 5） ==== -->
            <TextBlock
                x:Name="InterpretersGroupTitle"
                Text="{Binding GroupInterpreters}"
                FontSize="{ThemeResource FontSizeH3}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextTitleBrush}"
                Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding Interpreters}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding VersionDisplay}"
                                FontSize="{ThemeResource FontSizeBody}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextTitleBrush}"
                                MinWidth="56"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock
                                    Text="{Binding ExecutablePath, Converter={StaticResource MiddleEllipsis}, ConverterParameter=52}"
                                    ToolTipService.ToolTip="{Binding ExecutablePath}"
                                    FontSize="{ThemeResource FontSizeCaption}"
                                    Foreground="{ThemeResource TextMutedBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{Binding StatusText}"
                                    FontSize="{ThemeResource FontSizeOverline}"
                                    Foreground="{ThemeResource StatusSuccessBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="3"
                                AutomationProperties.AutomationId="SettingsRemoveInterpreterButton"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                MinWidth="26" MinHeight="24"
                                Padding="0"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="OnRemoveInterpreterClick" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="AddInterpreterButton"
                    AutomationProperties.AutomationId="SettingsAddInterpreterButton"
                    Content="{Binding AddInterpreterText}"
                    IsEnabled="{Binding IsAddingInterpreter, Converter={StaticResource InvertBool}}"
                    Click="OnAddInterpreterClick" />
                <!-- 版本检测行内转圈：不阻塞 UI -->
                <ProgressRing
                    Grid.Column="1"
                    IsActive="{Binding IsAddingInterpreter}"
                    Width="20" Height="20"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- ==== 分组三：运行选项（勾选即持久化） ==== -->
            <TextBlock
                Text="{Binding GroupRunOptions}"
                FontSize="{ThemeResource FontSizeH3}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextTitleBrush}"
                Margin="0,8,0,0" />
            <StackPanel Spacing="4">
                <CheckBox
                    AutomationProperties.AutomationId="SettingsOptAutoClear"
                    Content="{Binding OptAutoClearText}"
                    IsChecked="{Binding TerminalAutoClear, Mode=TwoWay}" />
                <CheckBox
                    AutomationProperties.AutomationId="SettingsOptNotifyOnFail"
                    Content="{Binding OptNotifyOnFailText}"
                    IsChecked="{Binding NotifyOnFail, Mode=TwoWay}" />
                <CheckBox
                    AutomationProperties.AutomationId="SettingsOptLiveFlush"
                    Content="{Binding OptLiveFlushText}"
                    IsChecked="{Binding LiveFlush, Mode=TwoWay}" />
                <CheckBox
                    AutomationProperties.AutomationId="SettingsOptAutoRefreshScripts"
                    Content="{Binding OptAutoRefreshScriptsText}"
                    IsChecked="{Binding AutoRefreshScripts, Mode=TwoWay}" />
                <CheckBox
                    AutomationProperties.AutomationId="SettingsOptAutoStart"
                    Content="{Binding OptAutoStartText}"
                    IsChecked="{Binding AutoStart, Mode=TwoWay}" />
            </StackPanel>

            <!-- ==== 分组四：语言（切换即时生效） ==== -->
            <TextBlock
                Text="{Binding GroupLanguage}"
                FontSize="{ThemeResource FontSizeH3}"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextTitleBrush}"
                Margin="0,8,0,0" />
            <ComboBox
                x:Name="LanguageCombo"
                AutomationProperties.AutomationId="SettingsLanguageCombo"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnLanguageSelectionChanged" />

            <!-- 行内错误提示（业务校验失败文案，本地化） -->
            <TextBlock
                Text="{Binding ErrorMessage}"
                Foreground="{ThemeResource DangerBrush}"
                FontSize="{ThemeResource FontSizeCaption}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
