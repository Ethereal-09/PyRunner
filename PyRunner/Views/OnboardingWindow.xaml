<Window
    x:Class="PyRunner.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PyRunner.Models">

    <Grid
        x:Name="RootLayout"
        AutomationProperties.AutomationId="OnboardingWindow"
        Background="{ThemeResource OnboardingWindowBackgroundBrush}"
        RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="23*" />
            <ColumnDefinition Width="77*" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <!-- WinUI 的标准强调控件默认跟随 Windows 系统强调色。引导窗口必须固定使用
                 PyRunner 品牌绿色，因此覆盖模板实际消费的语义资源，而不是硬编码控件颜色。 -->
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="OnboardingCardBrush" />
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="OnboardingAccentTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="OnboardingAccentTextBrush" />
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="OnboardingAccentTextBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="AccentBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="AccentBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="AccentHoverBrush" />
            <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="AccentPressedBrush" />
            <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="AccentBrush" />
            <StaticResource x:Key="ProgressRingForegroundThemeBrush" ResourceKey="AccentBrush" />
        </Grid.Resources>

        <!-- 固定品牌区 -->
        <Border
            Grid.Column="0"
            Background="{ThemeResource OnboardingBrandBackgroundBrush}"
            BorderBrush="{ThemeResource OnboardingBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid Padding="32,52,28,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border
                        Width="44" Height="44"
                        CornerRadius="8"
                        Background="{ThemeResource LogoGradientBrush}">
                        <TextBlock
                            Text="Py"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource OnboardingAccentTextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Text="PyRunner"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource OnboardingPrimaryTextBrush}" />
                        <TextBlock
                            Text="PYTHON SCRIPT MANAGER"
                            FontSize="10"
                            CharacterSpacing="35"
                            Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,62,0,0" Spacing="18">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        LineHeight="34"
                        Foreground="{ThemeResource OnboardingPrimaryTextBrush}">
                        <Run Text="让每个 Python 脚本" /><LineBreak />
                        <Run Text="都有" /><Run Text="归处" Foreground="{ThemeResource AccentLightBrush}" />
                    </TextBlock>
                    <TextBlock
                        x:Name="BrandDescriptionText"
                        FontSize="13"
                        LineHeight="23"
                        MaxWidth="228"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="2" Fill="{ThemeResource AccentBrush}" />
                    <TextBlock
                        x:Name="FirstUseText"
                        FontSize="11"
                        Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Column="1" Background="{ThemeResource OnboardingContentBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
                <RowDefinition Height="74" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏拖动区及四步指示器 -->
            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Row="0"
                Padding="32,0,150,0"
                BorderBrush="{ThemeResource OnboardingBorderBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border x:Name="StepCircle1" Width="26" Height="26" CornerRadius="13" BorderThickness="1">
                        <TextBlock x:Name="StepNumber1" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="StepLabel1" VerticalAlignment="Center" FontSize="12" />
                    <Rectangle x:Name="StepLine1" Width="26" Height="1" />
                    <Border x:Name="StepCircle2" Width="26" Height="26" CornerRadius="13" BorderThickness="1">
                        <TextBlock x:Name="StepNumber2" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="StepLabel2" VerticalAlignment="Center" FontSize="12" />
                    <Rectangle x:Name="StepLine2" Width="26" Height="1" />
                    <Border x:Name="StepCircle3" Width="26" Height="26" CornerRadius="13" BorderThickness="1">
                        <TextBlock x:Name="StepNumber3" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="StepLabel3" VerticalAlignment="Center" FontSize="12" />
                    <Rectangle x:Name="StepLine3" Width="26" Height="1" />
                    <Border x:Name="StepCircle4" Width="26" Height="26" CornerRadius="13" BorderThickness="1">
                        <TextBlock x:Name="StepNumber4" Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="StepLabel4" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="34,28,34,28" MinHeight="500">
                    <!-- 第一步：欢迎 -->
                    <StackPanel x:Name="WelcomePage" Spacing="16">
                        <TextBlock
                            x:Name="WelcomeTitleText"
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource OnboardingPrimaryTextBrush}" />
                        <TextBlock
                            x:Name="WelcomeDescriptionText"
                            MaxWidth="760"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            LineHeight="22"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                        <Grid ColumnSpacing="12" RowSpacing="12" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="76" />
                                <RowDefinition Height="76" />
                            </Grid.RowDefinitions>
                            <Border Background="{ThemeResource OnboardingCardBrush}" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="6" Background="{ThemeResource OnboardingAccentSurfaceBrush}"><ContentControl ContentTemplate="{StaticResource Icon_Folder}" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="FeatureTitle1" FontWeight="SemiBold" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" /><TextBlock x:Name="FeatureText1" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource OnboardingCardBrush}" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="6" Background="{ThemeResource OnboardingAccentSurfaceBrush}"><ContentControl ContentTemplate="{StaticResource Icon_Terminal}" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="FeatureTitle2" FontWeight="SemiBold" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" /><TextBlock x:Name="FeatureText2" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="{ThemeResource OnboardingCardBrush}" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="6" Background="{ThemeResource OnboardingAccentSurfaceBrush}"><ContentControl ContentTemplate="{StaticResource Icon_ScriptPy}" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="FeatureTitle3" FontWeight="SemiBold" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" /><TextBlock x:Name="FeatureText3" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource OnboardingCardBrush}" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="6" Background="{ThemeResource OnboardingAccentSurfaceBrush}"><Ellipse Width="14" Height="14" Fill="{ThemeResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="FeatureTitle4" FontWeight="SemiBold" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" /><TextBlock x:Name="FeatureText4" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /></StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 第二步：脚本目录 -->
                    <StackPanel x:Name="PathsPage" Spacing="13" Visibility="Collapsed">
                        <TextBlock x:Name="PathsTitleText" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" />
                        <TextBlock x:Name="PathsDescriptionText" MaxWidth="760" HorizontalAlignment="Left" FontSize="13" LineHeight="22" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PathInputBox"
                                AutomationProperties.AutomationId="OnboardingPathInput"
                                Height="38"
                                PlaceholderText="C:\Scripts"
                                TextChanged="OnPathInputTextChanged"
                                KeyDown="OnPathInputKeyDown" />
                            <Button
                                x:Name="BrowsePathButton"
                                AutomationProperties.AutomationId="OnboardingBrowsePathButton"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Height="38"
                                Click="OnBrowsePathClick" />
                            <Button x:Name="AddPathButton" AutomationProperties.AutomationId="OnboardingAddPathButton" Grid.Column="2" Margin="8,0,0,0" Height="38" Style="{StaticResource AccentButtonStyle}" Click="OnAddPathClick" />
                        </Grid>
                        <TextBlock x:Name="PathErrorText" FontSize="11" Foreground="{ThemeResource StatusErrorBrush}" Visibility="Collapsed" />
                        <ItemsControl x:Name="PathItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OnboardingPathItem">
                                    <Border Margin="0,0,0,8" Padding="14,10" Background="{ThemeResource OnboardingCardBrush}" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Path}" ToolTipService.ToolTip="{x:Bind Path}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="11" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="{x:Bind RemoveText}" ToolTipService.ToolTip="{x:Bind RemoveText}" Click="OnRemovePathClick" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Padding="14,10" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="1" CornerRadius="8">
                            <TextBlock x:Name="PathsTipText" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                        </Border>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2"><TextBlock x:Name="AutoRefreshTitleText" FontWeight="SemiBold" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" /><TextBlock x:Name="AutoRefreshDescriptionText" FontSize="11" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /></StackPanel>
                            <ToggleSwitch x:Name="AutoRefreshToggle" Grid.Column="1" IsOn="True" OffContent="" OnContent="" />
                        </Grid>
                    </StackPanel>

                    <!-- 第三步：解释器 -->
                    <StackPanel x:Name="InterpreterPage" Spacing="13" Visibility="Collapsed">
                        <TextBlock x:Name="InterpreterTitleText" FontSize="23" FontWeight="SemiBold" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" />
                        <TextBlock x:Name="InterpreterDescriptionText" MaxWidth="780" HorizontalAlignment="Left" FontSize="13" LineHeight="22" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                        <StackPanel x:Name="InterpreterScanningPanel" Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="InterpreterScanRing" Width="16" Height="16" IsActive="False" />
                            <TextBlock x:Name="InterpreterScanText" FontSize="11" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="InterpreterItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:OnboardingInterpreterItem">
                                    <RadioButton
                                        GroupName="OnboardingInterpreter"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Loaded="OnInterpreterRadioLoaded"
                                        Checked="OnInterpreterRadioCheckedChanged"
                                        Unchecked="OnInterpreterRadioCheckedChanged"
                                        Click="OnInterpreterChoiceClick"
                                        Margin="0,0,0,8"
                                        Padding="14,9"
                                        Background="{ThemeResource OnboardingCardBrush}"
                                        BorderBrush="{ThemeResource OnboardingBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                        <Grid MinWidth="620" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{x:Bind VersionText}" FontWeight="SemiBold" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" /><TextBlock Text="{x:Bind TypeText}" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind ExecutablePath}" ToolTipService.ToolTip="{x:Bind ExecutablePath}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Padding="10,4" CornerRadius="12" Background="{ThemeResource OnboardingAccentSurfaceBrush}"><TextBlock Text="{x:Bind BadgeText}" FontSize="10" Foreground="{ThemeResource AccentLightBrush}" /></Border>
                                        </Grid>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="ManualInterpreterButton" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Click="OnManualInterpreterClick" />
                        <Border Padding="14,10" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="1" CornerRadius="8"><TextBlock x:Name="InterpreterTipText" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /></Border>
                        <TextBlock x:Name="InterpreterErrorText" FontSize="11" Foreground="{ThemeResource StatusErrorBrush}" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- 第四步：完成 -->
                    <Grid x:Name="CompletePage" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Spacing="14">
                            <Border Width="78" Height="78" CornerRadius="39" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="1" Background="{ThemeResource OnboardingAccentSurfaceBrush}">
                                <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{ThemeResource AccentLightBrush}" />
                            </Border>
                            <TextBlock x:Name="CompleteTitleText" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" />
                            <TextBlock x:Name="CompleteDescriptionText" FontSize="12" LineHeight="21" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" />
                            <Border Margin="0,10,0,0" Padding="0,12" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="10">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="CompletePathsLabel" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /><TextBlock x:Name="CompletePathsStatusText" Grid.Column="1" Text="✓" Foreground="{ThemeResource AccentLightBrush}" /><TextBlock x:Name="CompletePathsValue" Grid.Column="2" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" TextTrimming="CharacterEllipsis" /></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="CompleteInterpreterLabel" Foreground="{ThemeResource OnboardingSecondaryTextBrush}" /><TextBlock x:Name="CompleteInterpreterStatusText" Grid.Column="1" Text="✓" Foreground="{ThemeResource AccentLightBrush}" /><TextBlock x:Name="CompleteInterpreterValue" Grid.Column="2" Foreground="{ThemeResource OnboardingPrimaryTextBrush}" TextTrimming="CharacterEllipsis" /></Grid>
                                </StackPanel>
                            </Border>
                            <Button x:Name="CenterStartButton" AutomationProperties.AutomationId="OnboardingCenterStartButton" Height="42" MinWidth="210" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="OnCompleteClick" />
                            <TextBlock x:Name="CompleteErrorText" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource StatusErrorBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- 固定底部导航 -->
            <Grid Grid.Row="2" Padding="32,0,32,0" BorderBrush="{ThemeResource OnboardingBorderBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse x:Name="FooterDot1" Width="8" Height="8" />
                        <Ellipse x:Name="FooterDot2" Width="8" Height="8" />
                        <Ellipse x:Name="FooterDot3" Width="8" Height="8" />
                        <Ellipse x:Name="FooterDot4" Width="8" Height="8" />
                    </StackPanel>
                    <Button x:Name="SkipButton" AutomationProperties.AutomationId="OnboardingSkipButton" Background="Transparent" BorderBrush="Transparent" Click="OnSkipClick" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="ExitButton" AutomationProperties.AutomationId="OnboardingExitButton" Width="96" Height="40" Click="OnExitClick" />
                    <Button x:Name="BackButton" AutomationProperties.AutomationId="OnboardingBackButton" Width="96" Height="40" Click="OnBackClick" />
                    <Button x:Name="NextButton" AutomationProperties.AutomationId="OnboardingNextButton" Width="104" Height="40" Style="{StaticResource AccentButtonStyle}" Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
