<Page x:Name="PageRoot"
    x:Class="PyRunner.Views.ScheduledTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PyRunner.Views">
    <Grid Background="{ThemeResource PanelSurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="22,0" BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TitleText}" FontSize="{ThemeResource FontSizeH3}" FontWeight="SemiBold" Foreground="{ThemeResource TextTitleBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" AutomationProperties.AutomationId="AddScheduledTaskButton" Content="{Binding AddText}" Click="OnAddClick" />
        </Grid>
        <Grid Grid.Row="1" Padding="22,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ScriptHeaderText}" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding RuleHeaderText}" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding NextHeaderText}" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding ResultHeaderText}" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="2">
            <ListView ItemsSource="{Binding Items}" SelectionMode="None">
                <ListView.ItemTemplate><DataTemplate>
                    <Border Margin="10,4" Padding="12" Background="{ThemeResource PanelSurfaceRaisedBrush}" CornerRadius="8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ScriptName}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RuleText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding NextRunText}" VerticalAlignment="Center" FontFamily="{ThemeResource TerminalFontFamily}" />
                            <TextBlock Grid.Column="3" Text="{Binding LastResultText}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="4" IsOn="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanEnable}" Toggled="OnEnabledToggled" VerticalAlignment="Center" />
                            <Button Grid.Column="5" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" MinWidth="34" Padding="0"><Button.Flyout><MenuFlyout>
                                <MenuFlyoutItem Text="{Binding RunNowText}" Click="OnRunNowClick" />
                                <MenuFlyoutItem Text="{Binding EditText}" Click="OnEditClick" />
                                <MenuFlyoutItem Text="{Binding DeleteText}" Click="OnDeleteClick" />
                            </MenuFlyout></Button.Flyout></Button>
                        </Grid>
                    </Border>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <views:EmptyStateView IconTemplate="{StaticResource Icon_Clock}" Description="{Binding EmptyText}" ShowButton="False" IsHitTestVisible="False" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Page>
