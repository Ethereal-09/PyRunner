<ContentDialog
    x:Class="PyRunner.Views.ScriptEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PyRunner.Views"
    Title="{Binding Title}"
    PrimaryButtonText="{Binding SaveText}"
    SecondaryButtonText="{Binding CancelText}"
    DefaultButton="Primary"
    Background="{ThemeResource PanelSurfaceRaisedBrush}"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <local:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel MinWidth="420" Spacing="4">

            <TextBlock Text="{Binding LabelName}" />
            <TextBox
                AutomationProperties.AutomationId="ScriptEditNameBox"
                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Text="{Binding NameError}"
                Foreground="{ThemeResource DangerBrush}"
                FontSize="12"
                Visibility="{Binding NameError, Converter={StaticResource NonEmptyToVisibility}}" />

            <TextBlock Text="{Binding LabelFilePath}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.AutomationId="ScriptEditPathBox"
                    Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{Binding FilePathPlaceholder}" />
                <!-- PRD §5.6：浏览按钮，FileOpenPicker 过滤 *.py 回填路径 -->
                <Button
                    x:Name="BrowseButton"
                    Grid.Column="1"
                    Content="{Binding BrowseText}"
                    Click="OnBrowseClick" />
            </Grid>
            <TextBlock
                Text="{Binding PathError}"
                Foreground="{ThemeResource DangerBrush}"
                FontSize="12"
                Visibility="{Binding PathError, Converter={StaticResource NonEmptyToVisibility}}" />

            <TextBlock Text="{Binding LabelCategory}" Margin="0,8,0,0" />
            <TextBox Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding LabelTags}" Margin="0,8,0,0" />
            <TextBox Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding LabelDescription}" Margin="0,8,0,0" />
            <TextBox
                Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Height="64" />

            <TextBlock Text="{Binding LabelInterpreter}" Margin="0,8,0,0" />
            <ComboBox
                AutomationProperties.AutomationId="ScriptEditInterpreterCombo"
                ItemsSource="{Binding Interpreters}"
                SelectedItem="{Binding SelectedInterpreter, Mode=TwoWay}"
                HorizontalAlignment="Stretch" />

            <TextBlock Text="{Binding LabelArguments}" Margin="0,8,0,0" />
            <TextBox
                AutomationProperties.AutomationId="ScriptEditArgumentsBox"
                Text="{Binding Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Text="{Binding ArgumentsError}"
                Foreground="{ThemeResource DangerBrush}"
                FontSize="12"
                Visibility="{Binding ArgumentsError, Converter={StaticResource NonEmptyToVisibility}}" />

            <TextBlock Text="{Binding LabelWorkingDirectory}" Margin="0,8,0,0" />
            <TextBox Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
