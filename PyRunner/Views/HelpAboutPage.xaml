<UserControl
    x:Class="PyRunner.Views.HelpAboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PyRunner.Views">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
    </UserControl.Resources>

    <ScrollViewer
        x:Name="HelpScroller"
        AutomationProperties.AutomationId="HelpAboutPage"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollMode="Auto"
        VerticalScrollBarVisibility="Auto"
        SizeChanged="OnHelpScrollerSizeChanged">
        <Grid
            x:Name="ResponsiveRoot"
            MaxWidth="1050"
            Margin="28,24,28,32"
            HorizontalAlignment="Center">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="PageTitleText"
                        Text="{Binding PageTitle}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock
                        x:Name="PageSubtitleText"
                        Text="{Binding PageSubtitle}"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>

                <Border
                    Padding="22"
                    Background="{ThemeResource PanelSurfaceRaisedBrush}"
                    BorderBrush="{ThemeResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid x:Name="HeroGrid" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeroFirstColumn" Width="64" />
                            <ColumnDefinition x:Name="HeroSecondColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl
                            ContentTemplate="{StaticResource Icon_Logo}"
                            Width="64"
                            Height="64"
                            VerticalAlignment="Top"
                            IsTabStop="False" />
                        <StackPanel x:Name="HeroDetails" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical" Spacing="3">
                                <TextBlock
                                    Text="PyRunner"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextPrimaryBrush}" />
                                <Border
                                    HorizontalAlignment="Left"
                                    Padding="9,2"
                                    Background="{ThemeResource StatusSuccessSurfaceBrush}"
                                    CornerRadius="12"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="VersionBadgeText"
                                        Text="{Binding VersionLine}"
                                        FontSize="10.5"
                                        Foreground="{ThemeResource StatusSuccessBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Text="PYTHON SCRIPT MANAGER for Windows"
                                FontSize="11"
                                Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock
                                x:Name="ProductDescriptionText"
                                Text="{Binding ProductDescription}"
                                Margin="0,5,0,0"
                                FontSize="12.5"
                                Foreground="{ThemeResource TextBodyBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="DetailsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="DetailsSecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Padding="18"
                        Background="{ThemeResource PanelSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="0,0,6,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding AuthorTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding AuthorAccount}" FontSize="13" Foreground="{ThemeResource AccentBrush}" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{Binding AuthorIdentity}" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding AuthorBio}" FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="SoftwareCard"
                        Grid.Column="1"
                        Padding="18"
                        Background="{ThemeResource PanelSurfaceRaisedBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Margin="6,0,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SoftwareTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding RuntimeInfo}" FontSize="11.5" Foreground="{ThemeResource TextBodyBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PythonInfo}" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TerminalInfo}" FontSize="11.5" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OsInfo}" FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LicenseInfo}" FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" Visibility="{Binding LicenseInfo, Converter={StaticResource NonEmptyToVisibility}}" />
                            <TextBlock Text="{Binding UpdateChannelInfo}" FontSize="11.5" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" Visibility="{Binding UpdateChannelInfo, Converter={StaticResource NonEmptyToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding QuickHelpTitle}" Margin="0,2,0,-6" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                <Grid x:Name="QuickHelpGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="QuickSecondColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="QuickCard1"
                        AutomationProperties.AutomationId="HelpAddFolderButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="16,13"
                        Margin="0,0,6,5"
                        Background="{ThemeResource ControlSurfaceBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Command="{Binding NavigateToSettingsCommand}"
                        CommandParameter="ScriptPaths">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontSize="17" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding AddFolderTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AddFolderDescription}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button
                        x:Name="QuickCard2"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="HelpInterpreterButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="16,13"
                        Margin="6,0,0,5"
                        Background="{ThemeResource ControlSurfaceBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Command="{Binding NavigateToSettingsCommand}"
                        CommandParameter="Interpreters">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="17" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding InterpreterTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InterpreterDescription}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button
                        x:Name="QuickCard3"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="HelpRunGuideButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="16,13"
                        Margin="0,5,6,0"
                        Background="{ThemeResource ControlSurfaceBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Command="{Binding ShowLocalHelpCommand}"
                        CommandParameter="Run">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE768;" FontSize="17" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding RunGuideTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RunGuideDescription}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button
                        x:Name="QuickCard4"
                        Grid.Row="1"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="HelpFaqButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="16,13"
                        Margin="6,5,0,0"
                        Background="{ThemeResource ControlSurfaceBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        Command="{Binding ShowLocalHelpCommand}"
                        CommandParameter="Faq">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE897;" FontSize="17" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding FaqTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FaqDescription}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <Border
                    x:Name="LocalHelpPanel"
                    AutomationProperties.AutomationId="HelpLocalTopic"
                    Visibility="{Binding IsLocalHelpOpen, Converter={StaticResource BoolToVisibility}}"
                    Padding="16,12"
                    Background="{ThemeResource ControlSurfaceBrush}"
                    BorderBrush="{ThemeResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                        <TextBlock AutomationProperties.AutomationId="HelpLocalTopicTitle" Text="{Binding LocalHelpTitle}" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalHelpBody}" Foreground="{ThemeResource TextBodyBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Close"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            MinWidth="28"
                            MinHeight="28"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Command="{Binding CloseLocalHelpCommand}" />
                    </Grid>
                </Border>

                <Border BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel Spacing="10">
                    <StackPanel x:Name="FooterActions" Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="CopyInfoButton"
                            AutomationProperties.AutomationId="HelpCopyInfoButton"
                            Content="{Binding CopyInfoText}"
                            Padding="16,7"
                            Background="{ThemeResource SecondaryButtonBrush}"
                            BorderBrush="{ThemeResource SecondaryButtonBorderBrush}"
                            Foreground="{ThemeResource SecondaryButtonForegroundBrush}"
                            Command="{Binding CopySoftwareInfoCommand}" />
                        <TextBlock
                            Text="{Binding CopyFeedbackText}"
                            Foreground="{ThemeResource StatusSuccessBrush}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsCopyFeedbackVisible, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Content="{Binding ProjectHomepageText}"
                            Command="{Binding OpenExternalLinkCommand}"
                            CommandParameter="Project"
                            Visibility="{Binding HasProjectLink, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Content="{Binding IssueTrackerText}"
                            Command="{Binding OpenExternalLinkCommand}"
                            CommandParameter="Issues"
                            Visibility="{Binding HasIssueLink, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Content="{Binding ReleasesPageText}"
                            Command="{Binding OpenExternalLinkCommand}"
                            CommandParameter="Releases"
                            Visibility="{Binding HasReleasesLink, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Content="{Binding AuthorHomepageText}"
                            Command="{Binding OpenExternalLinkCommand}"
                            CommandParameter="Author"
                            Visibility="{Binding HasAuthorLink, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Content="{Binding LicensePageText}"
                            Command="{Binding OpenExternalLinkCommand}"
                            CommandParameter="License"
                            Visibility="{Binding HasLicenseLink, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            Text="{Binding OnlineResourcesUnavailable}"
                            Foreground="{ThemeResource TextMutedBrush}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding ShowUnavailableResources, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            AutomationProperties.AutomationId="HelpCheckUpdatesButton"
                            Content="{Binding CheckUpdatesText}"
                            Command="{Binding CheckUpdatesCommand}"
                            Visibility="{Binding CanCheckUpdates, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressRing Width="18" Height="18" IsActive="{Binding IsCheckingUpdates}" Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding OperationMessage}" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding OperationMessage, Converter={StaticResource NonEmptyToVisibility}}" />
                    </StackPanel>
                    <Border
                        AutomationProperties.AutomationId="HelpUpdateStatusPanel"
                        Padding="14,12"
                        Background="{ThemeResource ControlSurfaceBrush}"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding ShowUpdateStatus, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                AutomationProperties.AutomationId="HelpUpdateStatusText"
                                Text="{Binding UpdateStatusText}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Spacing="6"
                                Visibility="{Binding ShowUpdateDetails, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding UpdateVersionText}" Foreground="{ThemeResource TextBodyBrush}" />
                                <TextBlock Text="{Binding UpdatePublishedText}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ReleaseNotesTitle}" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <ScrollViewer MaxHeight="140" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                                    <TextBlock
                                        AutomationProperties.AutomationId="HelpUpdateReleaseNotes"
                                        Text="{Binding UpdateReleaseNotes}"
                                        Foreground="{ThemeResource TextBodyBrush}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                                <ProgressBar
                                    AutomationProperties.AutomationId="HelpUpdateDownloadProgress"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding UpdateDownloadProgress}"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{Binding ShowDownloadProgress, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock
                                    Text="{Binding UpdateDownloadStatusText}"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding UpdateDownloadStatusText, Converter={StaticResource NonEmptyToVisibility}}" />
                                <StackPanel Spacing="6" HorizontalAlignment="Left">
                                    <Button
                                        AutomationProperties.AutomationId="HelpDownloadUpdateButton"
                                        Content="{Binding DownloadUpdateText}"
                                        Padding="16,7"
                                        Background="{ThemeResource SecondaryButtonBrush}"
                                        BorderBrush="{ThemeResource SecondaryButtonBorderBrush}"
                                        Foreground="{ThemeResource SecondaryButtonForegroundBrush}"
                                        Command="{Binding DownloadUpdateCommand}"
                                        Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        AutomationProperties.AutomationId="HelpCancelUpdateDownloadButton"
                                        Content="{Binding CancelUpdateDownloadText}"
                                        Padding="16,7"
                                        Command="{Binding CancelUpdateDownloadCommand}"
                                        Visibility="{Binding ShowCancelUpdateDownload, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        AutomationProperties.AutomationId="HelpInstallUpdateButton"
                                        Content="{Binding InstallUpdateText}"
                                        Padding="16,7"
                                        Command="{Binding InstallUpdateCommand}"
                                        Visibility="{Binding ShowInstallUpdate, Converter={StaticResource BoolToVisibility}}" />
                                    <Button
                                        AutomationProperties.AutomationId="HelpOpenReleasePageButton"
                                        Content="{Binding OpenReleasePageText}"
                                        Padding="16,7"
                                        Command="{Binding OpenReleasePageCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="{Binding CopyrightText}"
                    HorizontalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{ThemeResource TextDisabledBrush}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
