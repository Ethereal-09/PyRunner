<UserControl
    x:Class="PyRunner.Views.AiAssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PyRunner.Views">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid x:Name="PageRoot" Padding="24,18,24,16" RowSpacing="12"
          Background="{ThemeResource MainSurfaceBrush}" SizeChanged="OnPageSizeChanged"
          KeyDown="OnPageKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" MinHeight="42" ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                           FontSize="{ThemeResource FontSizeH2}" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextTitleBrush}" />
                <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextMutedBrush}" />
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button AutomationProperties.AutomationId="AiHistoryButton"
                        AutomationProperties.Name="{x:Bind ViewModel.HistoryText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleHistoryCommand}" MinHeight="36" Padding="14,7">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE81C;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.HistoryText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.AutomationId="AiNewConversationButton"
                        AutomationProperties.Name="{x:Bind ViewModel.NewConversationText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.NewConversationCommand}"
                        Background="{ThemeResource AccentBrush}"
                        Foreground="{ThemeResource PrimaryButtonForegroundBrush}"
                        BorderBrush="{ThemeResource SelectedBorderBrush}" MinHeight="36" Padding="14,7">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.NewConversationText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <ItemsControl HorizontalAlignment="Left" ItemsSource="{x:Bind ViewModel.ContextFiles, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" MinHeight="52" Padding="10,7"
                                Background="{ThemeResource ControlSurfaceBrush}"
                                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="7">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="5" Background="{ThemeResource GhostButtonHoverBrush}">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentLightBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                        Padding="4" MinWidth="24" MinHeight="24" Tag="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Loaded="OnRemoveContextButtonLoaded" Click="OnRemoveContextClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <WebView2 x:Name="MessageWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      DefaultBackgroundColor="Transparent"
                      AutomationProperties.AutomationId="AiConversationMessages" />

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,120,0,0" MaxWidth="720" Spacing="12"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" TextAlignment="Center"
                           FontSize="{ThemeResource FontSizeH3}" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextMutedBrush}" />
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapGrid Orientation="Horizontal" HorizontalAlignment="Center" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Items>
                        <Button Content="{x:Bind ViewModel.ExplainText, Mode=OneWay}" Tag="AI_Quick_Explain" Click="OnQuickPromptClick" Margin="4" />
                        <Button Content="{x:Bind ViewModel.DiagnoseText, Mode=OneWay}" Tag="AI_Quick_Diagnose" Click="OnQuickPromptClick" Margin="4" />
                        <Button Content="{x:Bind ViewModel.OptimizeText, Mode=OneWay}" Tag="AI_Quick_Optimize" Click="OnQuickPromptClick" Margin="4" />
                        <Button Content="{x:Bind ViewModel.RefactorText, Mode=OneWay}" Tag="AI_Quick_Refactor" Click="OnQuickPromptClick" Margin="4" />
                        <Button Content="{x:Bind ViewModel.GenerateText, Mode=OneWay}" Tag="AI_Quick_Generate" Click="OnQuickPromptClick" Margin="4" />
                    </ItemsControl.Items>
                </ItemsControl>
            </StackPanel>

        </Grid>

        <Border Grid.Row="3" MaxWidth="1100" MinHeight="104" Padding="13,9"
                Background="{ThemeResource PanelSurfaceRaisedBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9">
            <Grid RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{x:Bind ViewModel.ContextFiles, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasContext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="7,3" CornerRadius="5" Background="{ThemeResource ControlSurfaceBrush}"
                                    BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="11" Foreground="{ThemeResource AccentLightBrush}" />
                                    <TextBlock Text="{Binding DisplayName}" MaxWidth="190" FontSize="11"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Grid.Row="1" x:Name="PromptBox" Text="{x:Bind ViewModel.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{x:Bind ViewModel.PromptPlaceholder, Mode=OneWay}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="124"
                         BorderThickness="0" BorderBrush="Transparent" Background="Transparent" KeyDown="OnPromptKeyDown"
                         AutomationProperties.AutomationId="AiPromptTextBox">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>
                <Grid x:Name="ComposerControls" Grid.Row="2" ColumnSpacing="8" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Click="OnAddContextClick" Width="32" Height="32" Padding="5"
                            AutomationProperties.Name="{x:Bind ViewModel.AddContextText, Mode=OneWay}">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                    <ComboBox x:Name="ModeSelector" Grid.Column="1" ItemsSource="{x:Bind ViewModel.ModeOptions, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedModeIndex, Mode=TwoWay}"
                              MinWidth="142" AutomationProperties.AutomationId="AiModeSelector" />
                    <ComboBox x:Name="ModelSelector" Grid.Column="2" ItemsSource="{x:Bind ViewModel.ModelOptions, Mode=OneWay}"
                              SelectedIndex="0" MinWidth="120" IsEnabled="False"
                              AutomationProperties.AutomationId="AiModelSelector" />
                    <TextBlock x:Name="ComposerStatus" Grid.Column="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               MinWidth="0"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextMutedBrush}" />
                    <Button x:Name="PrimaryActionButton" Grid.Column="4" Click="OnPrimaryActionClick"
                            Width="38" Height="38" Padding="7" CornerRadius="19"
                            Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource PrimaryButtonForegroundBrush}"
                            AutomationProperties.AutomationId="AiPrimaryActionButton">
                        <FontIcon x:Name="PrimaryActionIcon" Glyph="&#xE724;" FontSize="16" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="HistoryPanel" Grid.RowSpan="4" Width="360" HorizontalAlignment="Right"
                Padding="14" Background="{ThemeResource PanelSurfaceRaisedBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9"
                Visibility="{x:Bind ViewModel.IsHistoryOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.HistoryText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                    <Button HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons"
                            Command="{x:Bind ViewModel.ToggleHistoryCommand}"
                            AutomationProperties.Name="{x:Bind ViewModel.CloseText, Mode=OneWay}" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedHistory, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="6" Spacing="3">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{x:Bind ViewModel.DeleteText, Mode=OneWay}" Command="{x:Bind ViewModel.DeleteHistoryCommand}" />
                    <Button Content="{x:Bind ViewModel.HistoryOpenText, Mode=OneWay}" Command="{x:Bind ViewModel.OpenHistoryCommand}"
                            Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource PrimaryButtonForegroundBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
