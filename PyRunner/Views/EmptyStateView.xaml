<UserControl
    x:Class="PyRunner.Views.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PyRunner.Views"
    IsTabStop="False">

    <!-- 参数化空状态控件（PRD §6.8.1 视觉口径）：图标 64×64 居中（#8a949e，图标模板
         内部已绑 IconMutedBrush；首启场景可换 Logo 主色模板）+ 13px 说明（距图标 16px）
         + 幽灵按钮（距文字 24px，可选；ShowButton=false 时按钮不渲染，评审修 5 补齐生效链路）。 -->
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        MaxWidth="300">
        <ContentControl
            x:Name="IconHost"
            ContentTemplate="{x:Bind IconTemplate, Mode=OneWay}"
            Width="64"
            Height="64"
            HorizontalAlignment="Center"
            IsTabStop="False" />
        <TextBlock
            x:Name="DescriptionText"
            Text="{x:Bind Description, Mode=OneWay}"
            FontSize="{ThemeResource FontSizeBody}"
            Foreground="{ThemeResource TextSecondaryBrush}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Margin="0,16,0,0" />
        <!-- 幽灵按钮：透明底 + 细边框；首启场景由调用方自行覆盖样式。
             Visibility 经 ShowButton 控制（评审修 5：旧实现 ShowButton 未接 Visibility，
             无按钮场景仍渲染空边框按钮） -->
        <Button
            x:Name="ActionButton"
            Content="{x:Bind ActionButtonText, Mode=OneWay}"
            Visibility="{x:Bind ShowButton, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            Background="Transparent"
            BorderBrush="{ThemeResource BorderHoverBrush}"
            BorderThickness="1"
            Click="OnActionClick" />
    </StackPanel>
</UserControl>
